# {{ ansible_managed }}
[Unit]
Description=Obtain or renew the Let's Encrypt certificate for {{ hashicorp_vault_domain }}
Wants=network-online.target
After=network-online.target docker.service

[Service]
Type=oneshot
EnvironmentFile=/etc/lego/cloudflare.env
ExecStart=/usr/local/bin/lego run \
  --accept-tos \
  --email {{ hashicorp_vault_acme_email }} \
  --domains {{ hashicorp_vault_domain }} \
  --key-type EC256 \
  --dns cloudflare \
  --dns.propagation.wait {{ hashicorp_vault_dns_propagation_wait }} \
  --path /etc/lego \
  --deploy-hook /usr/local/sbin/vault-cert-deploy \
  --log.format text
