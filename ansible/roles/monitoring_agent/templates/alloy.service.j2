## {{ ansible_managed }}
[Unit]
Description=Grafana Alloy (journal and Docker logs to Loki)
After=network-online.target docker.service
Wants=network-online.target

[Service]
Type=simple
User=alloy
Group=alloy
ExecStart=/usr/local/bin/alloy run /etc/alloy/config.alloy \
  --storage.path=/var/lib/alloy \
  --server.http.listen-addr=0.0.0.0:{{ monitoring_agent_alloy_port }} \
  --disable-reporting
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
ProtectSystem=strict
ReadWritePaths=/var/lib/alloy
ProtectHome=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
