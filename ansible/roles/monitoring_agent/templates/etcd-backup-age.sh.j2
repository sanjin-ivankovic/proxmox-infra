#!/bin/sh
## {{ ansible_managed }}
# Publishes the newest Talos etcd snapshot's mtime for node_exporter's
# textfile collector. Writes to a temp file and renames it, so a scrape never
# reads a half-written file.
set -eu

dir='{{ monitoring_agent_etcd_backup_dir }}'
out='{{ monitoring_agent_textfile_dir }}/talos_etcd_backup.prom'
tmp="$out.$$"

newest=$(find "$dir" -maxdepth 1 -type f -name 'etcd-*.db.gz' -printf '%T@\n' 2>/dev/null | sort -n | tail -1 | cut -d. -f1)
count=$(find "$dir" -maxdepth 1 -type f -name 'etcd-*.db.gz' 2>/dev/null | wc -l)

{
  echo '# HELP talos_etcd_backup_newest_timestamp_seconds mtime of the newest etcd snapshot (0 when none exist).'
  echo '# TYPE talos_etcd_backup_newest_timestamp_seconds gauge'
  echo "talos_etcd_backup_newest_timestamp_seconds ${newest:-0}"
  echo '# HELP talos_etcd_backup_files Number of etcd snapshots kept.'
  echo '# TYPE talos_etcd_backup_files gauge'
  echo "talos_etcd_backup_files ${count}"
} > "$tmp"
chmod 0644 "$tmp"
mv "$tmp" "$out"
