# Copy to terraform.tfvars.secret (gitignored) and fill in.
#   cp terraform.tfvars.secret.example terraform.tfvars.secret && chmod 600 terraform.tfvars.secret

# Control Plane → Admins & Users → <admin> → Create API Key.
# Prefer a dedicated Limited Admin with Local Access Only.
unifi_api_key = "xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"

# One entry per SSID managed in wlans.tf.
wlan_passphrases = {
  BaradDur = "changeme"
  Imladris = "changeme"
  Isengard = "changeme"
  Mithlond = "changeme"
}
