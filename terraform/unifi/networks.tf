# LAN networks (VLANs). Imported from the controller 2026-10-27.

resource "unifi_network" "net_01_infra" {
  dhcp_dns                               = ["10.110.0.12", "10.110.0.13"]
  dhcp_enabled                           = true
  dhcp_guarding                          = true
  dhcp_guarding_trusted_servers          = ["10.100.0.1"]
  dhcp_lease                             = 86400
  dhcp_relay_enabled                     = false
  dhcp_start                             = "10.100.0.200"
  dhcp_stop                              = "10.100.0.254"
  dhcp_v6_dns                            = []
  dhcp_v6_dns_auto                       = true
  dhcp_v6_enabled                        = false
  dhcp_v6_lease                          = 86400
  dhcp_v6_start                          = "::2"
  dhcp_v6_stop                           = "::7d1"
  dhcpd_boot_enabled                     = false
  dhcpd_gateway_enabled                  = false
  domain_name                            = "localdomain"
  enabled                                = true
  igmp_snooping                          = false
  internet_access_enabled                = true
  ipv6_interface_type                    = "none"
  ipv6_pd_start                          = "::2"
  ipv6_pd_stop                           = "::7d1"
  ipv6_ra_enable                         = true
  ipv6_ra_preferred_lifetime             = 14400
  ipv6_ra_priority                       = "high"
  ipv6_ra_valid_lifetime                 = 0
  multicast_dns                          = false
  name                                   = "01_INFRA"
  network_group                          = "LAN"
  network_isolation_enabled              = false
  purpose                                = "corporate"
  site                                   = "default"
  subnet                                 = "10.100.0.0/24"
  uid_vpn_custom_routing                 = []
  upnp_lan_enabled                       = false
  vlan_id                                = 0
  vpn_client_default_route               = false
  vpn_client_pull_dns                    = false
  wan_dns                                = []
  wan_egress_qos                         = 0
  wireguard_client_preshared_key         = null # sensitive
  wireguard_client_preshared_key_enabled = false
  x_wireguard_private_key                = null # sensitive
}

