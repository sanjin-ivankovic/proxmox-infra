lWidth=230;" vertex="1" parent="zones-29"><mxGeometry x="20" y="45" width="54" height="44" as="geometry"/></mxCell><mxCell id="zones-31" value="50_IOT · VLAN 50 · 10.150.0.0/24&lt;br&gt;Isengard · USW 9–12&lt;br&gt;DHCP .100–.199 · res. .50–.99&lt;br&gt;IGMP snooping · mDNS" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;" vertex="1" parent="zones-29"><mxGeometry x="155" y="40" width="210" height="90" as="geometry"/></mxCell><mxCell id="zones-32" value="User" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;container=1;collapsible=0;fillColor=#e9f7ef;strokeColor=#3d9970;strokeWidth=2;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontStyle=1;fontSize=13;" vertex="1" parent="1"><mxGeometry x="1210" y="310" width="360" height="190" as="geometry"/></mxCell><mxCell id="zones-33" value="" style="shape=mxgraph.networks.mobile;html=1;whiteSpace=wrap;fillColor=#d5e8d4;gradientColor=#97d077;strokeColor=#82b366;verticalLabelPosition=bottom;verticalAlign=top;align=center;aspect=fixed;fontSize=11;labelWidth=230;" vertex="1" parent="zones-32"><mxGeometry x="20" y="45" width="26" height="52" as="geometry"/></mxCell><mxCell id="zones-34" value="60_USER · VLAN 60&lt;br&gt;10.160.0.0/24 · Imladris&lt;br&gt;DHCP .100–.199&lt;br&gt;IGMP snooping · mDNS" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;" vertex="1" parent="zones-32"><mxGeometry x="155" y="40" width="210" height="90" as="geometry"/></mxCell><mxCell id="zones-35" value="Hotspot (predefined, = guest)" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;container=1;collapsible=0;fillColor=#fdecea;strokeColor=#b85450;strokeWidth=2;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontStyle=1;fontSize=13;" vertex="1" parent="1"><mxGeometry x="1210" y="530" width="360" height="190" as="geometry"/></mxCell><mxCell id="zones-36" value="" style="shape=mxgraph.networks.mobile;html=1;whiteSpace=wrap;fillColor=#f8cecc;gradientColor=#ea6b66;strokeColor=#b85450;verticalLabelPosition=bottom;verticalAlign=top;align=center;aspect=fixed;fontSize=11;labelWidth=230;" vertex="1" parent="zones-35"><mxGeometry x="20" y="45" width="26" height="52" as="geometry"/></mxCell><mxCell id="zones-37" value="70_GUEST · VLAN 70&lt;br&gt;10.170.0.0/24 · Mithlond&lt;br&gt;UCG DHCP .100–.199&lt;br&gt;isolation · 50/20 Mbit/s" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;" vertex="1" parent="zones-35"><mxGeometry x="155" y="40" width="210" height="90" as="geometry"/></mxCell><mxCell id="zones-38" value="" style="shape=mxgraph.networks.firewall;html=1;whiteSpace=wrap;fillColor=#f8cecc;gradientColor=#ea6b66;strokeColor=#b85450;verticalLabelPosition=bottom;verticalAlign=top;align=center;aspect=fixed;fontSize=11;labelWidth=230;" vertex="1" parent="1"><mxGeometry x="40" y="545" width="40" height="40" as="geometry"/></mxCell><mxCell id="zones-39" value="Allowed flows — everything else hits the predefined Block All" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=13;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="95" y="545" width="400" height="24" as="geometry"/></mxCell><mxCell id="zones-40" value="• Admin → every zone, Gateway, WAN: any&lt;br&gt;• VPN → Admin, Mgmt, Core, Servers, Storage, IoT, User: any · VPN → Guest: blocked&lt;br&gt;• Every zone → Core: DNS 53 to the filtering resolvers (10.110.0.12/.13) only&lt;br&gt;• Every zone → WAN: any, after anti-leak blocks (53, 853, public DoH on 443)&lt;br&gt;• Mgmt → Storage: pve → PBS 8007&lt;br&gt;• Core → Servers: git 443 to Traefik · Core → WAN: DoT 853 to Quad9 (filtering resolvers only)&lt;br&gt;• Servers → Core: Traefik → Pi-hole 80 / Technitium 5380, Komodo 8120, Semaphore SSH&lt;br&gt;• Servers → Mgmt: Semaphore → pve 22 / 8006&lt;br&gt;• Servers → Storage: Talos nodes → Unraid app ports (unraid_apps group)&lt;br&gt;• Servers → WAN: Talos workers → 1.1.1.1:53 (cert-manager)&lt;br&gt;• IoT → Servers: Traefik 80/443 · IoT → Storage: Plex 32400 + discovery&lt;br&gt;• User → Servers: Traefik 80/443 · User → IoT: any (casting)&lt;br&gt;• Core, Servers, Storage, IoT, User → Gateway: UCG admin ports and resolver blocked&lt;br&gt;• IPS (blocking) on every network but STORAGE · Internal and Dmz: predefined, empty" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#bbbbbb;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="600" width="1140" height="250" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="dns" name="3 DNS and DHCP"><mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1654" pageHeight="1169" background="#ffffff" adaptiveColors="none" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="dns-2" value="DNS and DHCP" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=20;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="16" width="1500" height="30" as="geometry"/></mxCell><mxCell id="dns-3" value="Pi-hole filters · Unbound resolves · Technitium is authoritative and the single DHCP server" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="46" width="1500" height="22" as="geometry"/></mxCell><mxCell id="dns-4" value="Clients (all VLANs)&lt;br&gt;DHCP option 6: Pi-hole&lt;br&gt;LXCs / Talos: static" style="shape=mxgraph.networks.laptop;html=1;whiteSpace=wrap;fillColor=#d5e8d4;gradientColor=#97d077;strokeColor=#82b366;verticalLabelPosition=bottom;verticalAlign=top;align=center;aspect=fixed;fontSize=11;labelWidth=230;" vertex="1" parent="1"><mxGeometry x="50" y="150" width="70" height="38" as="geometry"/></mxCell><mxCell id="dns-5" value="" style="shape=mxgraph.networks.mobile;html=1;whiteSpace=wrap;fillColor=#d5e8d4;gradientColor=#97d077;strokeColor=#82b366;verticalLabelPosit